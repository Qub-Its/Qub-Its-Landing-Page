# Web3Forms access key for the MCDU and PFD trainers' feedback panel (feedback-only key with hCaptcha enabled).
# Read through import.meta.env at build time (src/labs/shared/feedback/); without it the Feedback button stays hidden.
# Copy to .env.local (gitignored) for local dev; set it in Vercel for Preview and Production.
VITE_WEB3FORMS_FEEDBACK_KEY=
