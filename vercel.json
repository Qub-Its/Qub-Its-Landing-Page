{
  "installCommand": "npm --prefix landing-page-svelte ci",
  "buildCommand": "npm --prefix landing-page-svelte run build",
  "outputDirectory": "landing-page-svelte/dist",
  "rewrites": [
    {
      "source": "/labs/mcdu-trainer",
      "destination": "/labs/mcdu-trainer/index.html"
    },
    {
      "source": "/en/labs/mcdu-trainer",
      "destination": "/en/labs/mcdu-trainer/index.html"
    },
    {
      "source": "/en/labs/mcdu-trainer/",
      "destination": "/en/labs/mcdu-trainer/index.html"
    },
    {
      "source": "/labs/pfd-trainer",
      "destination": "/labs/pfd-trainer/index.html"
    },
    {
      "source": "/en/labs/pfd-trainer",
      "destination": "/en/labs/pfd-trainer/index.html"
    },
    {
      "source": "/en/labs/pfd-trainer/",
      "destination": "/en/labs/pfd-trainer/index.html"
    },
    {
      "source": "/labs/e6b-trainer",
      "destination": "/labs/e6b-trainer/index.html"
    },
    {
      "source": "/en/labs/e6b-trainer",
      "destination": "/en/labs/e6b-trainer/index.html"
    },
    {
      "source": "/en/labs/e6b-trainer/",
      "destination": "/en/labs/e6b-trainer/index.html"
    },
    {
      "source": "/labs/g1000-trainer",
      "destination": "/labs/g1000-trainer/index.html"
    },
    {
      "source": "/en/labs/g1000-trainer",
      "destination": "/en/labs/g1000-trainer/index.html"
    },
    {
      "source": "/en/labs/g1000-trainer/",
      "destination": "/en/labs/g1000-trainer/index.html"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/(.*)",
      "destination": "/en/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
